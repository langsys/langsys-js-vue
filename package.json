{
    "name": "langsys-js-vue",
    "version": "0.2.1",
    "description": "Vue 3 binding for the Langsys translation SDK — realtime continuous translations with automatic token discovery, delivered as composables and a <Translate> component.",
    "author": "Langsys",
    "license": "MIT",
    "homepage": "https://github.com/langsys/langsys-js-vue",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/langsys/langsys-js-vue.git"
    },
    "bugs": {
        "url": "https://github.com/langsys/langsys-js-vue/issues"
    },
    "engines": {
        "node": ">=18"
    },
    "main": "dist/index.js",
    "module": "dist/index.mjs",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.mjs",
            "require": "./dist/index.js"
        }
    },
    "files": [
        "dist",
        "README.md",
        "README-SSR.md",
        "CHANGELOG.md",
        "LICENSE"
    ],
    "sideEffects": false,
    "scripts": {
        "dev": "vite",
        "build": "tsup",
        "build:watch": "tsup --watch",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "test:watch": "vitest",
        "lint": "prettier --check . && eslint .",
        "format": "prettier --write .",
        "prepublishOnly": "npm run build",
        "release": "./_dev_/publish.sh",
        "test:mutations": "node _dev_/mutations.mjs"
    },
    "keywords": [
        "i18n",
        "l10n",
        "vue",
        "vue3",
        "composables",
        "nuxt",
        "language",
        "localization",
        "internationalization",
        "translation",
        "langsys",
        "sdk"
    ],
    "peerDependencies": {
        "vue": "^3.4.0"
    },
    "dependencies": {
        "langsys-js-typescript": "^0.6.5"
    },
    "devDependencies": {
        "@eslint/js": "^9.0.0",
        "@types/node": "^26.4.0",
        "@vitejs/plugin-vue": "^5.2.0",
        "eslint": "^9.0.0",
        "eslint-config-prettier": "^10.0.0",
        "eslint-plugin-vue": "^10.0.0",
        "jsdom": "^29.1.1",
        "prettier": "^3.3.0",
        "tsup": "^8.4.0",
        "typescript": "^5.8.3",
        "typescript-eslint": "^8.0.0",
        "vite": "^6.0.0",
        "vitest": "^4.1.7",
        "vue": "^3.5.0",
        "vue-router": "^5.3.0"
    }
}
